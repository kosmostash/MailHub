# Copy to .env for local development. Real environment variables override this file.

# --- required -----------------------------------------------------------------
# Postgres connection string
DATABASE_URL=postgres://postgres@127.0.0.1:5432/mailhub
# 32+ random bytes; derives session-token and provider-config encryption keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAILHUB_SECRET=change-me-to-32-plus-random-bytes

# --- web application ----------------------------------------------------------
# Where users reach the web app (used in system emails)
MAILHUB_PUBLIC_URL=http://localhost:4556
# Port for the production server (node dist/run.js -p $PORT)
PORT=4556

# --- system email (spec §2.1.8): confirmation codes, sent instantly ----------
# Nodemailer transport URL. Leave unset to log codes to stdout in development.
MAILHUB_SYSTEM_SMTP_URL=smtp://user:pass@smtp.example.test:587
MAILHUB_SYSTEM_FROM="MailHub <mailhub@example.test>"

# --- SMTP ingestion listener (spec §3.6): `pnpm smtp` ------------------------
MAILHUB_SMTP_HOST=0.0.0.0
MAILHUB_SMTP_PORT=2525
MAILHUB_SMTP_MAX_MESSAGE_BYTES=26214400

# --- background sender (spec §4.1): `pnpm sender` ----------------------------
MAILHUB_SENDER_INTERVAL_MS=2000
MAILHUB_SENDER_BATCH_SIZE=20

# --- tests --------------------------------------------------------------------
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/mailhub_test
