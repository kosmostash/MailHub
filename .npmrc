# pre/post scripts are on by default in pnpm 8+; stated here so `pnpm build` always runs postbuild (tsdown)
enable-pre-post-scripts=true

# pnpm 11 refuses versions published less than a day ago (minimumReleaseAge=1440).
# MailHub tracks KosmoJS releases closely; exempt them and keep the window for everything else.
minimum-release-age-exclude[]=@kosmojs/*
